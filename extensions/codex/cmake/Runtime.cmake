include(FetchContent)
# Native binaries from OpenAI's official platform packages. Preserve the vendor
# layout: sibling hosts, sandbox helpers, bundled search and macOS shell resources.
set(LITECODE_CODEX_VERSION "0.165.0")
if(WIN32 AND CMAKE_SYSTEM_PROCESSOR MATCHES "AMD64|amd64|x86_64")
    set(_codex_platform win32-x64)
    set(_codex_triple x86_64-pc-windows-msvc)
    set(_codex_hash 7f92cccae80f4a7028be74e747537e48d1d24df599fb29b90381f7cd91f3ff386e306306643f08c547654949446e210d6323d7ac9f06dc987e08bcb34df401e9)
elseif(APPLE)
    set(_codex_arch "${CMAKE_OSX_ARCHITECTURES}")
    if(NOT _codex_arch)
        set(_codex_arch "${CMAKE_SYSTEM_PROCESSOR}")
    endif()
    if(_codex_arch MATCHES ";")
        message(FATAL_ERROR "Codex requires a single-architecture macOS package")
    endif()
    if(_codex_arch MATCHES "arm64|aarch64")
        set(_codex_platform darwin-arm64)
        set(_codex_triple aarch64-apple-darwin)
        set(_codex_hash 310fd9d17c3dbf4f031ee9e7ce8762f4dc00f38e0c237f913bbd8833ca342ebfd47a69e512804c0b1a688ecb715fa99fe5943052b220d327a40ddf5c159dbd86)
    else()
        set(_codex_platform darwin-x64)
        set(_codex_triple x86_64-apple-darwin)
        set(_codex_hash 9b132d967b6752ad176fcae3bc7a61dd6b34e3943cd812db78a45176437bd04b3d9a1a3f0ff0658754a166fcd03a7b28795c3c95b57d7ce2e35b5be7728b9f29)
    endif()
elseif(UNIX)
    if(CMAKE_SYSTEM_PROCESSOR MATCHES "arm64|aarch64")
        set(_codex_platform linux-arm64)
        set(_codex_triple aarch64-unknown-linux-musl)
        set(_codex_hash a9dad875c69bc67ddb897daa4ed6ff1aeb8c936d1901063172663b947729e82900cf2aac5db2f4bc8245c1626bf37fe934cf825191f861a4cf9ecda437b6487c)
    else()
        set(_codex_platform linux-x64)
        set(_codex_triple x86_64-unknown-linux-musl)
        set(_codex_hash 168b4373b6d51f06a89a6b6c7433fc3cfac7d1ae48c02fedf07fcb85d11c1f8101aa07981510ada6d88772ec20bcd4422db4db3b2144fd4afa1b360296381a49)
    endif()
else()
    message(FATAL_ERROR "No pinned Codex runtime for this architecture")
endif()
FetchContent_Declare(codex_runtime
    URL "https://registry.npmjs.org/@openai/codex/-/codex-${LITECODE_CODEX_VERSION}-${_codex_platform}.tgz"
    URL_HASH "SHA512=${_codex_hash}"
    DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
FetchContent_MakeAvailable(codex_runtime)
set(LITECODE_CODEX_DIRECTORY "${codex_runtime_SOURCE_DIR}/vendor/${_codex_triple}")
if(NOT IS_DIRECTORY "${LITECODE_CODEX_DIRECTORY}/bin")
    message(FATAL_ERROR "Pinned Codex archive has an unexpected layout")
endif()
